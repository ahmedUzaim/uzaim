<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AI Tools Hub</title>

    <style>
        /* =========================
           GLOBAL STYLES
        ========================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: #f7f8fc;
            color: #171827;
            line-height: 1.6;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button,
        input {
            font-family: inherit;
        }

        .container {
            width: 90%;
            max-width: 1200px;
            margin: auto;
        }

        /* =========================
           NAVBAR
        ========================== */

        header {
            background: #ffffff;
            border-bottom: 1px solid #e8e8ef;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .navbar {
            height: 72px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            font-size: 24px;
            font-weight: 800;
            color: #6c4df6;
        }

        .logo span {
            color: #171827;
        }

        .nav-links {
            display: flex;
            gap: 28px;
            list-style: none;
        }

        .nav-links a {
            font-size: 15px;
            color: #55576b;
            font-weight: 600;
            transition: 0.3s;
        }

        .nav-links a:hover {
            color: #6c4df6;
        }

        .submit-btn {
            background: #6c4df6;
            color: white;
            padding: 10px 18px;
            border-radius: 8px;
            font-weight: 600;
            transition: 0.3s;
        }

        .submit-btn:hover {
            background: #5639df;
            transform: translateY(-2px);
        }

        /* =========================
           HERO SECTION
        ========================== */

        .hero {
            padding: 90px 20px;
            text-align: center;
            background:
                radial-gradient(circle at top left, #e7e1ff, transparent 35%),
                radial-gradient(circle at bottom right, #dff8ff, transparent 35%),
                #f7f8fc;
        }

        .hero h1 {
            font-size: clamp(40px, 6vw, 70px);
            line-height: 1.1;
            max-width: 850px;
            margin: auto;
            font-weight: 800;
            letter-spacing: -2px;
        }

        .hero h1 span {
            color: #6c4df6;
        }

        .hero p {
            max-width: 650px;
            margin: 22px auto 35px;
            color: #686b7d;
            font-size: 18px;
        }

        .search-box {
            max-width: 650px;
            margin: auto;
            display: flex;
            background: white;
            padding: 7px;
            border-radius: 14px;
            box-shadow: 0 10px 35px rgba(50, 40, 100, 0.12);
            border: 1px solid #ececf4;
        }

        .search-box input {
            flex: 1;
            border: none;
            outline: none;
            padding: 15px;
            font-size: 16px;
        }

        .search-box button {
            border: none;
            background: #6c4df6;
            color: white;
            padding: 0 25px;
            border-radius: 9px;
            cursor: pointer;
            font-weight: 700;
        }

        /* =========================
           CATEGORIES
        ========================== */

        .categories {
            padding: 50px 0 20px;
        }

        .section-title {
            text-align: center;
            margin-bottom: 30px;
        }

        .section-title h2 {
            font-size: 32px;
            margin-bottom: 8px;
        }

        .section-title p {
            color: #77798b;
        }

        .category-list {
            display: flex;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .category {
            border: 1px solid #dedee8;
            background: white;
            padding: 10px 18px;
            border-radius: 30px;
            cursor: pointer;
            color: #55576b;
            transition: 0.3s;
        }

        .category:hover,
        .category.active {
            background: #6c4df6;
            border-color: #6c4df6;
            color: white;
        }

        /* =========================
           TOOLS GRID
        ========================== */

        .tools-section {
            padding: 50px 0 90px;
        }

        .tools-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
        }

        .tool-card {
            background: white;
            border: 1px solid #e7e7ef;
            border-radius: 18px;
            padding: 25px;
            transition: 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .tool-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 18px 40px rgba(30, 25, 70, 0.12);
            border-color: #d7d0ff;
        }

        .tool-icon {
            width: 55px;
            height: 55px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            background: #eeeaff;
            margin-bottom: 20px;
        }

        .tool-card h3 {
            font-size: 21px;
            margin-bottom: 8px;
        }

        .tool-card p {
            color: #707284;
            font-size: 14px;
            margin-bottom: 20px;
            min-height: 68px;
        }

        .tool-info {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .tag {
            background: #f0edff;
            color: #6748ec;
            padding: 5px 10px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
        }

        .price {
            font-size: 13px;
            color: #55576b;
            font-weight: 600;
        }

        .visit-btn {
            display: block;
            text-align: center;
            background: #171827;
            color: white;
            padding: 11px;
            border-radius: 9px;
            font-weight: 600;
            transition: 0.3s;
        }

        .visit-btn:hover {
            background: #6c4df6;
        }

        /* =========================
           CTA
        ========================== */

        .cta {
            background: linear-gradient(135deg, #6c4df6, #8b5cf6);
            color: white;
            padding: 70px 20px;
            text-align: center;
        }

        .cta h2 {
            font-size: 38px;
            margin-bottom: 15px;
        }

        .cta p {
            max-width: 600px;
            margin: 0 auto 25px;
            color: #e9e5ff;
        }

        .cta-btn {
            display: inline-block;
            background: white;
            color: #6042e5;
            padding: 13px 25px;
            border-radius: 9px;
            font-weight: 700;
        }

        /* =========================
           FOOTER
        ========================== */

        footer {
            background: #11121c;
            color: white;
            padding: 45px 0;
        }

        .footer-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 30px;
        }

        .footer-logo {
            font-size: 22px;
            font-weight: 800;
        }

        .footer-logo span {
            color: #8b72ff;
        }

        .footer-text {
            color: #999aaa;
            font-size: 14px;
        }

        .footer-links {
            display: flex;
            gap: 20px;
            color: #aaaabb;
            font-size: 14px;
        }

        .footer-links a:hover {
            color: white;
        }

        /* =========================
           RESPONSIVE DESIGN
        ========================== */

        @media (max-width: 900px) {
            .tools-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .nav-links {
                display: none;
            }
        }

        @media (max-width: 600px) {
            .hero {
                padding: 65px 15px;
            }

            .hero h1 {
                font-size: 42px;
            }

            .hero p {
                font-size: 16px;
            }

            .search-box {
                flex-direction: column;
                gap: 8px;
                background: transparent;
                box-shadow: none;
                border: none;
            }

            .search-box input {
                background: white;
                border-radius: 9px;
                border: 1px solid #e5e5ee;
            }

            .search-box button {
                height: 48px;
            }

            .tools-grid {
                grid-template-columns: 1fr;
            }

            .footer-content {
                flex-direction: column;
                text-align: center;
            }

            .cta h2 {
                font-size: 30px;
            }
        }
    </style>
</head>

<body>

    <!-- =========================
         NAVIGATION
    ========================== -->

    <header>
        <div class="container navbar">

            <a href="#" class="logo">
                AI<span>Hub</span>
            </a>

            <ul class="nav-links">
                <li><a href="#home">Home</a></li>
                <li><a href="#tools">AI Tools</a></li>
                <li><a href="#categories">Categories</a></li>
                <li><a href="#about">About</a></li>
            </ul>

            <a href="#submit" class="submit-btn">
                Submit Tool
            </a>

        </div>
    </header>


    <!-- =========================
         HERO
    ========================== -->

    <section class="hero" id="home">

        <h1>
            Discover the Best
            <span>AI Tools</span>
            in One Place
        </h1>

        <p>
            Explore powerful artificial intelligence tools for productivity,
            writing, design, coding, marketing and more.
        </p>

        <div class="search-box">
            <input
                type="text"
                placeholder="Search AI tools..."
                id="searchInput"
            >

            <button onclick="searchTools()">
                Search
            </button>
        </div>

    </section>


    <!-- =========================
         CATEGORIES
    ========================== -->

    <section class="categories" id="categories">

        <div class="container">

            <div class="section-title">
                <h2>Explore Categories</h2>
                <p>Find the right AI tool for your needs.</p>
            </div>

            <div class="category-list">

                <button class="category active" onclick="filterTools('all')">
                    All
                </button>

                <button class="category" onclick="filterTools('writing')">
                    ✍️ Writing
                </button>

                <button class="category" onclick="filterTools('design')">
                    🎨 Design
                </button>

                <button class="category" onclick="filterTools('coding')">
                    💻 Coding
                </button>

                <button class="category" onclick="filterTools('marketing')">
                    📈 Marketing
                </button>

                <button class="category" onclick="filterTools('video')">
                    🎬 Video
                </button>

            </div>

        </div>

    </section>


    <!-- =========================
         AI TOOLS
    ========================== -->

    <section class="tools-section" id="tools">

        <div class="container">

            <div class="section-title">
                <h2>Popular AI Tools</h2>
                <p>Hand-picked tools to boost your productivity.</p>
            </div>

            <div class="tools-grid" id="toolsGrid">


                <!-- Tool 1 -->

                <div class="tool-card" data-category="writing">

                    <div class="tool-icon">
                        ✍️
                    </div>

                    <h3>AI Writer</h3>

                    <p>
                        Generate articles, blog posts, emails and
                        creative content with AI.
                    </p>

                    <div class="tool-info">
                        <span class="tag">Writing</span>
                        <span class="price">Free + Pro</span>
                    </div>

                    <a href="#" class="visit-btn">
                        Visit Tool →
                    </a>

                </div>


                <!-- Tool 2 -->

                <div class="tool-card" data-category="design">

                    <div class="tool-icon">
                        🎨
                    </div>

                    <h3>Design AI</h3>

                    <p>
                        Create stunning graphics, images and
                        creative designs using artificial intelligence.
                    </p>

                    <div class="tool-info">
                        <span class="tag">Design</span>
                        <span class="price">Free + Pro</span>
                    </div>

                    <a href="#" class="visit-btn">
                        Visit Tool →
                    </a>

                </div>


                <!-- Tool 3 -->

                <div class="tool-card" data-category="coding">

                    <div class="tool-icon">
                        💻
                    </div>

                    <h3>Code Assistant</h3>

                    <p>
                        Write, debug and explain code faster
                        with an AI-powered coding assistant.
                    </p>

                    <div class="tool-info">
                        <span class="tag">Coding</span>
                        <span class="price">Free</span>
                    </div>

                    <a href="#" class="visit-btn">
                        Visit Tool →
                    </a>

                </div>


                <!-- Tool 4 -->

                <div class="tool-card" data-category="marketing">

                    <div class="tool-icon">
                        📈
                    </div>

                    <h3>Marketing AI</h3>

                    <p>
                        Create marketing campaigns, social posts
                        and advertising copy automatically.
                    </p>

                    <div class="tool-info">
                        <span class="tag">Marketing</span>
                        <span class="price">Paid</span>
                    </div>

                    <a href="#" class="visit-btn">
                        Visit Tool →
                    </a>

                </div>


                <!-- Tool 5 -->

                <div class="tool-card" data-category="video">

                    <div class="tool-icon">
                        🎬
                    </div>

                    <h3>Video AI</h3>

                    <p>
                        Generate and edit videos using powerful
                        AI video generation technology.
                    </p>

                    <div class="tool-info">
                        <span class="tag">Video</span>
                        <span class="price">Free + Pro</span>
                    </div>

                    <a href="#" class="visit-btn">
                        Visit Tool →
                    </a>

                </div>


                <!-- Tool 6 -->

                <div class="tool-card" data-category="writing">

                    <div class="tool-icon">
                        📝
                    </div>

                    <h3>AI Summarizer</h3>

                    <p>
                        Quickly summarize long documents,
                        articles and research papers.
                    </p>

                    <div class="tool-info">
                        <span class="tag">Writing</span>
                        <span class="price">Free</span>
                    </div>

                    <a href="#" class="visit-btn">
                        Visit Tool →
                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         CTA
    ========================== -->

    <section class="cta" id="submit">

        <div class="container">

            <h2>Have an AI Tool?</h2>

            <p>
                Submit your AI tool and get it discovered
                by thousands of AI enthusiasts.
            </p>

            <a href="#" class="cta-btn">
                Submit Your Tool
            </a>

        </div>

    </section>


    <!-- =========================
         FOOTER
    ========================== -->

    <footer id="about">

        <div class="container footer-content">

            <div class="footer-logo">
                AI<span>Hub</span>
            </div>

            <p class="footer-text">
                © 2026 AIHub. Discover. Explore. Create.
            </p>

            <div class="footer-links">
                <a href="#">Privacy</a>
                <a href="#">Terms</a>
                <a href="#">Contact</a>
            </div>

        </div>

    </footer>


    <!-- =========================
         JAVASCRIPT
    ========================== -->

    <script>

        // Search AI tools
        function searchTools() {

            const input =
                document.getElementById("searchInput")
                .value
                .toLowerCase();

            const cards =
                document.querySelectorAll(".tool-card");

            cards.forEach(card => {

                const text =
                    card.innerText.toLowerCase();

                if (text.includes(input)) {
                    card.style.display = "block";
                } else {
                    card.style.display = "none";
                }

            });

        }


        // Category filtering
        function filterTools(category) {

            const cards =
                document.querySelectorAll(".tool-card");

            const buttons =
                document.querySelectorAll(".category");

            // Update active category
            buttons.forEach(button => {
                button.classList.remove("active");
            });

            event.target.classList.add("active");


            // Filter cards
            cards.forEach(card => {

                if (
                    category === "all" ||
                    card.dataset.category === category
                ) {

                    card.style.display = "block";

                } else {

                    card.style.display = "none";

                }

            });

        }


        // Search when pressing Enter
        document
            .getElementById("searchInput")
            .addEventListener("keyup", function(event) {

                if (event.key === "Enter") {
                    searchTools();
                }

            });

    </script>

</body>
</html>
